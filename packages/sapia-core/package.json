{
  "name": "@sapia/core",
  "version": "0.1.2-snapshot.0",
  "description": "UI-agnostic core of Sapia: plugin system, language registry, diagram metamodels, conversion, i18n, storage, config and AI tool contracts.",
  "license": "MIT",
  "keywords": [
    "diagram",
    "plantuml",
    "mermaid",
    "uml",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hakenadu/sapia.git",
    "directory": "packages/sapia-core"
  },
  "homepage": "https://github.com/Hakenadu/sapia#readme",
  "bugs": {
    "url": "https://github.com/Hakenadu/sapia/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}
