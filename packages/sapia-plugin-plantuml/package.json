{
  "name": "@sapia/plugin-plantuml",
  "version": "0.1.1-snapshot.0",
  "description": "PlantUML language support for Sapia: detection, highlighting, completion, validation, in-browser rendering and metamodel converters.",
  "license": "MIT",
  "keywords": [
    "sapia",
    "sapia-plugin",
    "plantuml",
    "diagram",
    "uml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hakenadu/sapia.git",
    "directory": "packages/sapia-plugin-plantuml"
  },
  "homepage": "https://github.com/Hakenadu/sapia#readme",
  "bugs": {
    "url": "https://github.com/Hakenadu/sapia/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sapia": {
    "plugin": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@plantuml/core": "^1.2026.10"
  },
  "peerDependencies": {
    "@sapia/core": "^0.1.1-snapshot.0"
  },
  "engines": {
    "node": ">=22"
  }
}
