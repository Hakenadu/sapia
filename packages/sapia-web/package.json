{
  "name": "@sapia/web",
  "version": "0.1.4-snapshot.0",
  "description": "Sapia web application as a ready-built static site (Angular, zoneless, Material) for any web server.",
  "license": "MIT",
  "keywords": [
    "diagram",
    "plantuml",
    "mermaid",
    "editor",
    "uml",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hakenadu/sapia.git",
    "directory": "packages/sapia-web"
  },
  "homepage": "https://github.com/Hakenadu/sapia#readme",
  "bugs": {
    "url": "https://github.com/Hakenadu/sapia/issues"
  },
  "files": [
    "dist/sapia-web/browser",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "assets": "node scripts/copy-assets.mjs",
    "prestart": "npm run assets",
    "prebuild": "npm run assets",
    "prewatch": "npm run assets",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cdk": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@plantuml/core": "^1.2026.10",
    "@sapia/core": "0.1.4-snapshot.0",
    "@sapia/plugin-mermaid": "0.1.4-snapshot.0",
    "@sapia/plugin-plantuml": "0.1.4-snapshot.0",
    "jsdom": "^30.0.0",
    "lucide": "^1.73.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
